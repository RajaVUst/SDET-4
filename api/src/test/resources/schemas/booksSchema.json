{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "isbn": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subTitle": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "publish_date": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "pages": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        },
        "required": [
          "isbn",
          "title",
          "author",
          "publisher",
          "website"
        ]
      }
    }
  },
  "required": [
    "books"
  ]
}